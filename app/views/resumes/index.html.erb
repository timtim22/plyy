<%= stylesheet_link_tag "animations", "data-turbo-track": "reload" %>
<%= csrf_meta_tags %>

<style>
  .job-card {
    transform: translateY(20px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  .job-card.animate {
    opacity: 1 !important;
    transform: translateY(0);
  }

  .count-updated {
    animation: pulse 0.3s ease-in-out;
  }

  @keyframes pulse {
    0% { transform: scale(1); }
    50% { transform: scale(1.1); }
    100% { transform: scale(1); }
  }
</style>

<!-- OPTION 1: Minimalist abstract art (medium tones) -->
<div id="option1" class="min-h-screen w-full flex flex-col items-center option1-bg relative overflow-hidden">
  <!-- Navbar -->
  <div class="w-full px-4 py-4 flex justify-end items-center relative z-50">
    <div class="flex space-x-3">
      <% if user_signed_in? %>
        <%= button_to "Log Out", destroy_user_session_path, method: :delete, class: "px-4 py-2 rounded-lg bg-emerald-500 hover:bg-emerald-600 text-white font-medium text-sm transition-all duration-300 shadow-md hover:shadow-lg", form: { class: "inline-block" } %>
      <% else %>
        <a href="/users/sign_in" data-turbo="false" class="px-4 py-2 rounded-lg bg-emerald-500 hover:bg-emerald-600 text-white font-medium text-sm transition-all duration-300 shadow-md hover:shadow-lg">Log In</a>
        <a href="/users/sign_up" data-turbo="false" class="px-4 py-2 rounded-lg bg-emerald-500 hover:bg-emerald-600 text-white font-medium text-sm transition-all duration-300 shadow-md hover:shadow-lg">Sign Up</a>
      <% end %>
    </div>
  </div>

  <!-- Original shapes -->
  <div id="shape1" class="shape absolute h-80 w-80 rounded-full bg-emerald-400/20"></div>
  <div id="shape3" class="shape absolute h-40 w-40 bg-teal-300/30 rounded-sm"></div>
  <div id="shape4" class="shape absolute h-52 w-52 border-4 border-emerald-400 rounded-full"></div>

  <!-- New background shapes -->
  <div id="shape5" class="shape absolute h-64 w-64 rounded-full bg-teal-500/15"></div>
  <div id="shape6" class="shape absolute h-36 w-36 rounded-full bg-emerald-400/20"></div>
  <div id="shape7" class="shape absolute h-48 w-48 rounded-full border-2 border-teal-400/30"></div>
  <div id="shape8" class="shape absolute h-32 w-32 bg-emerald-300/20 rounded-sm"></div>

  <!-- Container for particles -->
  <div id="particles-container" class="absolute inset-0 pointer-events-none"></div>

  <!-- Upload section -->
  <div class="flex justify-center items-center min-h-screen w-full">
    <!-- Modern upload component with states -->
    <div class="upload-button-container relative z-10">
      <!-- Hidden static file input -->
      <div id="resume-form" class="hidden">
        <input type="file" id="resume-file-input" accept=".pdf,.docx,.doc">
      </div>

      <!-- Initial state button -->
      <button id="upload-button" class="group relative px-12 py-6 rounded-xl shadow-lg transition-all duration-300 overflow-hidden w-80 h-40 bg-yellow-400 border-2 border-yellow-400" style="background-color: #FACC15 !important;">
        <!-- Button content -->
        <div class="relative flex flex-col items-center space-y-3">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 transition-all duration-300 group-hover:translate-y-[-2px] group-hover:scale-110" fill="none" viewBox="0 0 24 24" stroke="black">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
          </svg>
          <span class="text-lg font-medium tracking-wide" style="color: black;">UPLOAD RESUME</span>
        </div>
      </button>

      <!-- Loading state (hidden by default) -->
      <div id="loading-state" class="hidden group relative px-12 py-6 rounded-xl shadow-lg transition-all duration-300 overflow-hidden border border-slate-200 w-96">
        <!-- Animated gradient background -->
        <div class="absolute inset-0 bg-gradient-to-r from-emerald-400/40 via-white/80 to-teal-300/40 background-animate"></div>

        <!-- Backdrop blur and base background -->
        <div class="absolute inset-0 backdrop-blur-sm bg-white/50"></div>

        <!-- Loading content -->
        <div class="relative flex flex-col items-center space-y-4">
          <span class="text-lg font-medium text-slate-700 tracking-wide transition-all duration-300">
            <span id="loading-text">SCANNING RESUME</span>
          </span>

          <!-- Progress bar container -->
          <div class="w-full max-w-xs bg-slate-200 rounded-full h-2.5 overflow-hidden">
            <div id="progress-bar" class="bg-gradient-to-r from-emerald-400 to-teal-600 h-2.5 rounded-full w-0 transition-all duration-300"></div>
          </div>

          <!-- Job count display -->
          <div class="flex items-center justify-center w-full max-w-xs">
            <span id="jobs-found" class="text-sm font-medium text-slate-700">0 jobs found</span>
          </div>

          <span id="file-name" class="text-sm text-slate-500 max-w-xs truncate mt-2 w-full text-center"></span>
        </div>
      </div>
    </div>
  </div>

  <!-- Job results section (hidden by default) -->
  <!-- Moved to show.html.erb -->

</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const uploadButton = document.getElementById('upload-button');
  const fileInput = document.getElementById('resume-file-input');
  const loadingState = document.getElementById('loading-state');
  const loadingText = document.getElementById('loading-text');
  const fileNameElement = document.getElementById('file-name');
  const progressBar = document.getElementById('progress-bar');
  const jobsFoundElement = document.getElementById('jobs-found');

  // Loading text variations
  const loadingTexts = [
    'SCANNING RESUME',
    'ANALYZING SKILLS',
    'MATCHING JOBS'
  ];

  // Polling interval for checking progress (in ms)
  const POLLING_INTERVAL = 1000;
  let pollingTimer = null;
  let currentSearchId = null;
  let textInterval = null;

  // Function to check job progress
  function checkJobProgress() {
    if (!currentSearchId) return;

    fetch(`/job_progress/${currentSearchId}`)
      .then(response => response.json())
      .then(data => {
        // Update job count display
        const jobCount = data.job_count || 0;
        const totalTarget = data.total_target || 20;
        const oldJobCount = parseInt(jobsFoundElement.textContent.split(' ')[0]) || 0;

        if (oldJobCount !== jobCount) {
          console.log(`Jobs found: ${jobCount}`);

          // Add animation class
          jobsFoundElement.classList.add('count-updated');

          // Update text
          jobsFoundElement.textContent = jobCount + ' jobs found';

          // Calculate progress percentage
          const progressPct = Math.min(Math.round((jobCount / totalTarget) * 100), 100);
          progressBar.style.width = progressPct + '%';

          // Remove animation class after animation completes
          setTimeout(() => {
            jobsFoundElement.classList.remove('count-updated');
          }, 300);
        }

        // If search is complete, redirect to the results page
        if (data.completed) {
          clearInterval(pollingTimer);
          clearInterval(textInterval);

          // Ensure progress bar shows 100%
          progressBar.style.width = '100%';

          // Redirect to the results page
          window.location.href = `/resumes/${currentSearchId}`;
        }
      })
      .catch(error => {
        console.error('Error checking job progress:', error);
      });
  }

  // Trigger file input when button is clicked
  uploadButton.addEventListener('click', function() {
    fileInput.click();
  });

  // Handle file selection
  fileInput.addEventListener('change', function(e) {
    if (this.files && this.files.length > 0) {
      const fileName = this.files[0].name;
      console.log('Selected file:', fileName);

      // Display the file name in loading state
      fileNameElement.textContent = fileName;

      // Reset progress bar and job count
      progressBar.style.width = '0%';
      jobsFoundElement.textContent = '0 jobs found';

      // Hide the upload button
      uploadButton.classList.add('hidden');

      // Show loading state
      loadingState.classList.remove('hidden');

      // Start changing loading text - slowed down to 1.5 seconds
      let textIndex = 0;
      textInterval = setInterval(function() {
        loadingText.textContent = loadingTexts[textIndex];
        textIndex = (textIndex + 1) % loadingTexts.length;
      }, 1500);

      // Create FormData and append the file
      const formData = new FormData();
      formData.append('resume[file]', this.files[0]);

      // CSRF token for Rails
      const token = document.querySelector('meta[name="csrf-token"]').getAttribute('content');

      // Submit the form data via AJAX
      fetch('/resumes', {
        method: 'POST',
        headers: {
          'X-CSRF-Token': token
        },
        body: formData
      })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          // Store the search ID for polling
          currentSearchId = data.search_id;

          console.log(`Search ID: ${currentSearchId}`);

          // Start polling for progress
          clearInterval(pollingTimer);
          pollingTimer = setInterval(checkJobProgress, POLLING_INTERVAL);

          // Initial progress check
          checkJobProgress();
        } else {
          // Clear intervals
          clearInterval(textInterval);
          clearInterval(pollingTimer);

          alert('Error uploading resume: ' + data.errors.join(', '));

          // Reset the UI
          loadingState.classList.add('hidden');
          uploadButton.classList.remove('hidden');
        }
      })
      .catch(error => {
        console.error('Error:', error);

        // Clear intervals
        clearInterval(textInterval);
        clearInterval(pollingTimer);

        alert('An error occurred while processing your resume');

        // Reset the UI
        loadingState.classList.add('hidden');
        uploadButton.classList.remove('hidden');
      });
    }
  });
});
</script>
